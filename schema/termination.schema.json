{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsx-format.org/schema/0.1/termination.schema.json",
  "title": "DSX Termination object",
  "description": "v0.1-draft. Playback-independent. MUST be evaluable onboard without a ground link.",
  "type": "object",
  "required": ["channel", "escalation", "geofence", "link_loss"],
  "properties": {
    "channel": { "const": "independent" },
    "escalation": {
      "type": "array",
      "items": { "enum": ["hold", "coordinated_rth", "land_in_place", "disarm"] },
      "minItems": 1,
      "description": "each rung MUST be triggerable by a single operator action"
    },
    "rth_availability": {
      "type": "object",
      "properties": {
        "default_interval_ms": { "type": "integer", "default": 15000 },
        "adaptive": { "type": "boolean" },
        "windows": {
          "type": "array",
          "description": "feasibility map over the timeline: a collision-free return may not exist during a dense transition",
          "items": {
            "type": "object",
            "required": ["from_ms", "to_ms", "feasible"],
            "properties": {
              "from_ms": { "type": "integer", "minimum": 0 },
              "to_ms": { "type": "integer", "minimum": 0 },
              "feasible": { "type": "boolean" },
              "interval_ms": { "type": "integer" },
              "reason": { "type": "string" },
              "available_escalation": {
                "type": "array",
                "items": { "enum": ["hold", "coordinated_rth", "land_in_place", "disarm"] }
              }
            }
          }
        }
      }
    },
    "geofence": {
      "type": "object",
      "required": ["soft", "hard"],
      "properties": {
        "soft": {
          "type": "object",
          "required": ["type", "action"],
          "properties": {
            "type": { "enum": ["bubble"] },
            "radius_m": { "type": "number", "exclusiveMinimum": 0 },
            "action": { "enum": ["auto_land", "hold", "disarm"] },
            "timeout_ms": { "type": "integer" }
          }
        },
        "hard": {
          "type": "object",
          "required": ["type", "action"],
          "properties": {
            "type": { "enum": ["polygon", "cylinder"] },
            "ref": { "type": "string" },
            "action": { "enum": ["disarm", "land_in_place"] }
          }
        }
      }
    },
    "link_loss": {
      "type": "object",
      "required": ["heartbeat_timeout_ms", "action_on_loss"],
      "properties": {
        "heartbeat_timeout_ms": { "type": "integer", "exclusiveMinimum": 0 },
        "action_on_loss": { "enum": ["autonomous_fts", "coordinated_rth", "land_in_place", "continue"] }
      }
    },
    "fallback_channel": {
      "type": "object",
      "properties": {
        "required_for_profile": { "enum": ["L1", "L2"] },
        "independent_hardware": { "type": "boolean" },
        "auth": { "type": "string" }
      }
    },
    "disarmed_fall_containment": {
      "type": "object",
      "required": ["required"],
      "description": "the safety area MUST contain the ballistic trajectory of a disarmed aircraft from every position the show reaches",
      "properties": {
        "required": { "type": "boolean" },
        "verified": { "type": "boolean" },
        "verified_by": { "type": "string" }
      }
    }
  }
}
